<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Permission de voirie</title>

<style>
body {
  font-family: Arial;
  background: #f4f6f9;
  padding: 20px;
}

.container {
  max-width: 700px;
  margin: auto;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 10px;
  margin-bottom: 20px;
}

input, textarea {
  width: 100%;
  padding: 10px;
  margin: 8px 0;
}

button {
  background: #0078d4;
  color: white;
  border: none;
  padding: 10px;
  cursor: pointer;
}

.success {
  color: green;
  font-weight: bold;
}
</style>
</head>

<body>

<div class="container">

<h1>📡 Dépôt de permission de voirie</h1>

<div class="card">

<input id="projet" placeholder="Nom du projet">
<input id="adresse" placeholder="Adresse">
<input id="commune" placeholder="Commune">
<input id="email" placeholder="Email collectivité">

<textarea id="desc" placeholder="Description"></textarea>

<button onclick="envoyer()">Envoyer</button>

<p id="resultat" class="success"></p>

</div>

<div class="card">
<h3>📊 Suivi</h3>
<ul id="liste"></ul>
</div>

</div>

<script>

function envoyer() {

  const projet = document.getElementById("projet").value;
  const adresse = document.getElementById("adresse").value;
  const commune = document.getElementById("commune").value;
  const email = document.getElementById("email").value;
  const desc = document.getElementById("desc").value;

  if (!projet || !commune || !email) {
    alert("Remplis projet + commune + email !");
    return;
  }

  const sujet = encodeURIComponent(
    "Demande de permission de voirie - " + projet
  );

  const body = encodeURIComponent(
    "Madame, Monsieur,\n\n" +
    "Dans le cadre du déploiement de notre réseau fibre optique CELESTE,\n" +
    "nous souhaitons obtenir une permission de voirie.\n\n" +
    "Projet : " + projet + "\n" +
    "Adresse : " + adresse + "\n" +
    "Commune : " + commune + "\n\n" +
    "Description :\n" + desc + "\n\n" +
    "Dans l’attente de votre retour.\n\nCordialement"
  );

  window.location.href = `mailto:${email}?subject=${sujet}&body=${body}`;

  document.getElementById("resultat").innerText =
    "✅ Mail prêt à être envoyé";

  const li = document.createElement("li");
  li.innerText = "📌 " + projet + " - " + commune + " - Mail préparé";

  document.getElementById("liste").appendChild(li);
}

</script>

</body>
</html>
